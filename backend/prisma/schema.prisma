datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String?
  avatarUrl         String?
  googleId          String?            @unique
  senders           Sender[]
  emails            EmailJob[]
  slackIntegration  SlackIntegration?
  createdAt         DateTime           @default(now())
}

model Sender {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  displayName       String
  smtpHost          String             @default("smtp.ethereal.email")
  smtpPort          Int                @default(587)
  smtpUser          String
  smtpPass          String
  maxEmailsPerHour  Int                @default(200)
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  emails            EmailJob[]
  createdAt         DateTime           @default(now())
}

model EmailJob {
  id               String             @id @default(uuid())
  bullJobId        String?            @unique
  recipientEmail   String
  recipientName    String?
  subject          String
  body             String
  scheduledAt      DateTime
  sentAt           DateTime?
  status           String             @default("pending") // pending, queued, sending, rate_limited, sent, failed
  attempts         Int                @default(0)
  lastError        String?
  senderId         String
  sender           Sender             @relation(fields: [senderId], references: [id])
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  batchId          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model SlackIntegration {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id])
  accessToken      String
  webhookUrl       String
  teamId           String?
  isActive         Boolean            @default(true)
  connectedAt      DateTime           @default(now())
}
